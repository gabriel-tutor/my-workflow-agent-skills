#!/usr/bin/env python3
"""PostToolUse hook on the Skill tool: record a declaration when a process skill ran.

Only a completed invocation reaches this hook, so a failed or unknown skill never counts.
Prints nothing. Any error exits 0 (fail open) with the traceback on stderr.
"""
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))


def main() -> int:
    try:
        import seams_gate as gate
        event = json.loads(sys.stdin.read() or "{}")
        if event.get("tool_name") != "Skill":
            return 0
        skill = (event.get("tool_input") or {}).get("skill") or ""
        if gate.is_declaration(skill):
            session = event.get("session_id") or ""
            ledger = gate.load_ledger(session)
            gate.add_declaration(ledger, skill, event.get("agent_id"))
            gate.save_ledger(session, ledger)
    except Exception:                                  # fail open
        import traceback
        traceback.print_exc(file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
