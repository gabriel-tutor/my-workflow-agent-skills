#!/usr/bin/env python3
"""PostToolUse hook on the Skill tool: record a declaration when a process skill ran, and
mark the request verified when a verification skill ran.

Only a completed invocation reaches this hook, so a failed or unknown skill never counts.
Prints nothing. Fails open (see seams_gate.run_hook).
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import seams_gate as gate  # noqa: E402


def handle(event: dict):
    if event.get("tool_name") != "Skill":
        return None
    skill = (event.get("tool_input") or {}).get("skill") or ""
    declares, verifies = gate.is_declaration(skill), gate.is_verification(skill)
    if not (declares or verifies):
        return None
    session = event.get("session_id") or ""
    ledger = gate.load_ledger(session)
    if declares:
        gate.add_declaration(ledger, skill, event.get("agent_id"))
    if verifies:
        gate.mark_verified(ledger)
    gate.save_ledger(session, ledger)
    return None

if __name__ == "__main__":
    sys.exit(gate.run_hook(handle))
