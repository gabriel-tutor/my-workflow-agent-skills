#!/usr/bin/env python3
"""PreToolUse hook: refuse a change to the project until the request has a declaration.

Reads the event on stdin. Prints a deny decision with the reason when the gate is closed;
prints nothing otherwise, recording an allowed change in the session's ledger. Any error
prints nothing and exits 0 (fail open), with the traceback on stderr for the debug log.
"""
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))


def main() -> int:
    try:
        import seams_gate as gate
        event = json.loads(sys.stdin.read() or "{}")
        session = event.get("session_id") or ""
        ledger = gate.load_ledger(session)
        decision = gate.decide_pre_tool_use(event, ledger)
        if decision["decision"] == "deny":
            print(json.dumps({"hookSpecificOutput": {
                "hookEventName": "PreToolUse",
                "permissionDecision": "deny",
                "permissionDecisionReason": decision["reason"],
            }}))
        elif decision["change"]:
            gate.add_change(ledger, decision["change"])
            gate.save_ledger(session, ledger)
    except Exception:                                  # fail open
        import traceback
        traceback.print_exc(file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
