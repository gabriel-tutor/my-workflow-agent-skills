#!/usr/bin/env python3
"""UserPromptSubmit hook: a new prompt starts a new request.

A short go-ahead ("yes", "ok, do that") keeps the current request. A typed slash command for
a process skill starts a new request already declared. The prompt text itself is never
stored. Prints nothing. Fails open (see seams_gate.run_hook).
"""
import os
import sys

sys.dont_write_bytecode = True                 # no __pycache__ in the plugin directory
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import seams_gate as gate  # noqa: E402


def handle(event: dict):
    prompt = event.get("prompt") or ""
    session = event.get("session_id") or ""
    declared = gate.slash_declaration(prompt)
    if declared is None and gate.is_continuation(prompt):
        return None
    ledger = gate.load_ledger(session)
    gate.new_request(ledger)
    if declared:
        gate.add_declaration(ledger, declared)
    gate.save_ledger(session, ledger)
    return None

if __name__ == "__main__":
    sys.exit(gate.run_hook(handle))
